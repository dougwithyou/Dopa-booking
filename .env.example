# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (platform account — used only for the Stripe Connect OAuth flow) ---
# These belong to Dopa Studio's/your PLATFORM Stripe account, not any
# connected studio's account. Connected account IDs are stored per-studio
# in the `studios` table via the Connect OAuth flow — see /admin/settings.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dopa Studio <bookings@hidopastudio.com>"
ADMIN_NOTIFICATION_EMAIL=hello@hidopastudio.com

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
